      <column caption='Churn Rate' datatype='real' name='[Calculation_1404670431039489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Churn] = TRUE then 1 else 0 end)/ COUNT([State])' />
