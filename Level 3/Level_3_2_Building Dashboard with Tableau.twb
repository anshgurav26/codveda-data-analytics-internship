        <calculation class='tableau' formula='IF ISNULL([Account length])&#13;&#10;OR ISNULL([Area code])&#13;&#10;OR ISNULL([International plan])&#13;&#10;OR ISNULL([Voice mail plan])&#13;&#10;OR ISNULL([Number vmail messages])&#13;&#10;OR ISNULL([Total day minutes])&#13;&#10;OR ISNULL([Total day calls])&#13;&#10;OR ISNULL([Total day charge])&#13;&#10;OR ISNULL([Total eve minutes])&#13;&#10;OR ISNULL([Total eve calls])&#13;&#10;OR ISNULL([Total eve charge])&#13;&#10;OR ISNULL([Total night minutes])&#13;&#10;OR ISNULL([Total night calls])&#13;&#10;OR ISNULL([Total night charge])&#13;&#10;OR ISNULL([Total intl minutes])&#13;&#10;OR ISNULL([Total intl calls])&#13;&#10;OR ISNULL([Total intl charge])&#13;&#10;OR ISNULL([Customer service calls])&#13;&#10;OR ISNULL([Churn])&#13;&#10;THEN &quot;Missing&quot;&#13;&#10;ELSE &quot;Complete&quot;&#13;&#10;END' />
